generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model comment {
  id        Int      @id @default(autoincrement())
  content   String
  taskId    Int
  authorId  Int
  createdAt DateTime @default(now())
  user      user     @relation(fields: [authorId], references: [id], map: "Comment_authorId_fkey")
  task      task     @relation(fields: [taskId], references: [id], map: "Comment_taskId_fkey")

  @@index([authorId], map: "Comment_authorId_fkey")
  @@index([taskId], map: "Comment_taskId_fkey")
}

model project {
  id            Int             @id @default(autoincrement())
  title         String
  description   String?
  deadline      DateTime?
  createdAt     DateTime        @default(now())
  projectmember projectmember[]
  task          task[]
}

model projectmember {
  id        Int     @id @default(autoincrement())
  userId    Int
  projectId Int
  role      String  @default("Member")
  project   project @relation(fields: [projectId], references: [id], map: "ProjectMember_projectId_fkey")
  user      user    @relation(fields: [userId], references: [id], map: "ProjectMember_userId_fkey")

  @@index([projectId], map: "ProjectMember_projectId_fkey")
  @@index([userId], map: "ProjectMember_userId_fkey")
}

model task {
  id           Int         @id @default(autoincrement())
  title        String
  description  String?
  status       task_status @default(TODO)
  assignedToId Int?
  projectId    Int
  createdAt    DateTime    @default(now())
  comment      comment[]
  user         user?       @relation(fields: [assignedToId], references: [id], map: "Task_assignedToId_fkey")
  project      project     @relation(fields: [projectId], references: [id], map: "Task_projectId_fkey")

  @@index([assignedToId], map: "Task_assignedToId_fkey")
  @@index([projectId], map: "Task_projectId_fkey")
}

model user {
  id                 Int        @id @default(autoincrement())
  name               String
  email              String     @unique
  password           String
  createdAt          DateTime   @default(now())
  resetToken         String?    // token for password reset
  resetTokenExpiry   DateTime?  // token expiry
  comment            comment[]
  projectmember      projectmember[]
  task               task[]
}


enum task_status {
  TODO
  IN_PROGRESS
  DONE
}

enum user_role {
  ADMIN
  CLIENT
  MEMBER
}
