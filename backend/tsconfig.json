{
  "compilerOptions": {
    /* ===== Output Settings ===== */
    "rootDir": "./src",                // your TS source code folder
    "outDir": "./dist",                // compiled JS output folder

    /* ===== Module & Target ===== */
    "target": "ES2020",                // modern JS features, safe for Node 16+
    "module": "CommonJS",              // Express, dotenv, etc. use CommonJS
    "moduleResolution": "Node",        // standard Node module resolution
    "esModuleInterop": true,           // allow `import express from "express"`
    "resolveJsonModule": true,         // enables importing JSON files

    /* ===== Type Checking ===== */
    "strict": true,                    // enable all strict type checking
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,              // skip .d.ts file checks for faster build
    "noImplicitAny": true,             // catch untyped variables
    "noUnusedLocals": true,            // warn about unused variables
    "noUnusedParameters": true,        // warn about unused function params

    /* ===== Source Maps & Declarations ===== */
    "sourceMap": true,                 // helpful for debugging
    "declaration": true,               // generate .d.ts type definition files
    "declarationMap": true,            // source maps for declarations

    /* ===== Node.js Types ===== */
    "types": ["node"],                 // include Node types globally
    "lib": ["ES2020"],                 // use modern JS standard library
    "allowSyntheticDefaultImports": true
  },
  "include": ["src"],                  // include your source folder
  "exclude": ["node_modules", "dist"]  // exclude build + dependencies
}
